{
  "name": "@khosla/preflight",
  "version": "0.1.7",
  "publishConfig": {
    "access": "public"
  },
  "description": "Local ship gate for agent-built software: multi-judge findings, grounded diffs, executable verdict.",
  "type": "module",
  "license": "MIT",
  "author": "Geet Khosla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gvkhosla/preflight.git"
  },
  "bugs": {
    "url": "https://github.com/gvkhosla/preflight/issues"
  },
  "homepage": "https://gvkhosla.github.io/preflight/",
  "keywords": [
    "preflight",
    "code-review",
    "coding-agents",
    "git-diff",
    "llm-judge",
    "cli",
    "ai-agents",
    "developer-tools"
  ],
  "bin": {
    "preflight": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --packages=external --platform=node --format=esm --outfile=dist/cli.js && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "prepublishOnly": "npm run build",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "eval": "bun evals/score.ts",
    "eval:live": "bun evals/live.ts",
    "dev": "bun src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@pierre/diffs": "1.2.12",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.0"
  }
}
